{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AuditRunV1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","run_id","status","operation","host","config_sha256","source_revisions","tools","candidates","baseline_llvm_major"],
  "properties":{
    "schema_version":{"const":1},
    "run_id":{"type":"string","pattern":"^[a-f0-9]{32}$"},
    "status":{"enum":["passed","failed","blocked"]},
    "operation":{"enum":["preflight","run"]},
    "host":{"type":"object","additionalProperties":false,"required":["os","arch","distribution"],"properties":{"os":{"type":"string"},"arch":{"type":"string"},"distribution":{"type":"object","additionalProperties":false,"required":["id","version_id"],"properties":{"id":{"type":["string","null"]},"version_id":{"type":["string","null"]}}}}},
    "config_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_revisions":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-f0-9]{40}$"}},
    "tools":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","version","status"],"properties":{"name":{"type":"string"},"version":{"type":["string","null"]},"status":{"enum":["observed","missing"]}}}},
    "candidates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/candidate"}},
    "baseline_llvm_major":{"type":["integer","null"],"enum":[14,18,null]}
  },
  "$defs":{
    "phase":{"type":"object","additionalProperties":false,"required":["name","status","code","argv","exit_code","duration_ms","stdout_path","stderr_path"],"properties":{
      "name":{"type":"string"},"status":{"enum":["passed","failed","blocked","skipped"]},"code":{"type":"string"},
      "argv":{"type":"array","items":{"type":"string"}},"exit_code":{"type":["integer","null"]},"duration_ms":{"type":"integer","minimum":0},
      "stdout_path":{"type":["string","null"]},"stderr_path":{"type":["string","null"]}
    }},
    "candidate":{"type":"object","additionalProperties":false,"required":["llvm_major","status","phases","fixtures","missing_symbols"],"properties":{
      "llvm_major":{"enum":[14,18]},"status":{"enum":["passed","failed","blocked","build-only"]},
      "phases":{"type":"array","items":{"$ref":"#/$defs/phase"}},
      "fixtures":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["sha256","status","code"],"properties":{"sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"status":{"enum":["passed","failed","blocked","skipped"]},"code":{"type":"string"}}}},
      "missing_symbols":{"type":"array","items":{"type":"string"}}
    }}
  }
}
