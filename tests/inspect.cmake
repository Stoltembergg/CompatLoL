file(REMOVE_RECURSE "${TEST_DIR}")
file(MAKE_DIRECTORY "${TEST_DIR}/bundle")
file(COPY "${FIXTURE}" DESTINATION "${TEST_DIR}/bundle")
execute_process(COMMAND "${CLI}" inspect --bundle "${TEST_DIR}/bundle" --out "${TEST_DIR}/inventory.json" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "initial inspection failed")
endif()
file(READ "${TEST_DIR}/inventory.json" inventory)
string(JSON count LENGTH "${inventory}" binaries)
if(APPLE AND NOT count EQUAL 1)
  message(FATAL_ERROR "Mach-O native fixture not inventoried")
endif()
get_filename_component(name "${FIXTURE}" NAME)
file(SHA256 "${TEST_DIR}/bundle/${name}" before)
file(CREATE_LINK "${TEST_DIR}/bundle/${name}" "${TEST_DIR}/alias")
execute_process(COMMAND "${CLI}" inspect --bundle "${TEST_DIR}/bundle" --out "${TEST_DIR}/alias" RESULT_VARIABLE refused)
if(refused EQUAL 0)
  message(FATAL_ERROR "existing hard-link output accepted")
endif()
file(SHA256 "${TEST_DIR}/bundle/${name}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "inspection changed source fixture")
endif()
execute_process(COMMAND "${CLI}" inspect --bundle "${TEST_DIR}/bundle" --out "${TEST_DIR}/bundle/output.json" RESULT_VARIABLE inside)
if(inside EQUAL 0)
  message(FATAL_ERROR "in-bundle output accepted")
endif()
