foreach(mode IN ITEMS missing-json invalid-json blocked-run)
  if(mode STREQUAL "missing-json")
    set(args doctor)
  elseif(mode STREQUAL "invalid-json")
    set(args doctor --unexpected)
  else()
    set(args run --profile riot --bundle nonexistent)
  endif()
  execute_process(COMMAND "${CLI}" ${args} RESULT_VARIABLE exit_code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT exit_code EQUAL 2 OR NOT stdout STREQUAL "")
    message(FATAL_ERROR "Expected fail-closed exit 2 with empty stdout: ${mode}")
  endif()
  foreach(field IN ITEMS schema_version run_id monotonic_ns pid tid component severity code message fields)
    string(JSON type ERROR_VARIABLE error TYPE "${stderr}" ${field})
    if(NOT error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "Invalid log field ${field}: ${error}")
    endif()
  endforeach()
  string(JSON code GET "${stderr}" code)
  if(NOT code STREQUAL "OPERATION_REFUSED")
    message(FATAL_ERROR "Unexpected refusal code")
  endif()
endforeach()
